# Environment Configuration
PROJECT_NAME="Personalized News & Information Platform"
ENVIRONMENT="development"
DEBUG=true

# Database (PostgreSQL with SQLite fallback)
DATABASE_URL="sqlite:///./news_platform.db"
# Example PostgreSQL URL:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/news_platform"

# Redis Cache (Optional, defaults to in-memory fallback)
REDIS_URL="redis://localhost:6379/0"
REDIS_ENABLED=false
CACHE_TTL_TRENDING=300
CACHE_TTL_ARTICLE=3600
CACHE_TTL_FEED=180

# Messaging (Local queue fallback enabled by default)
KAFKA_BOOTSTRAP_SERVERS="localhost:9092"
KAFKA_ENABLED=false

# External News Ingestion (Optional)
NEWS_API_KEY=""

# Security & Auth
SECRET_KEY="dev-secret-key-change-in-production-personalized-news"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
